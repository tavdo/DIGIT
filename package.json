{
  "name": "homework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix server start",
    "dev:all": "concurrently \"npm run server\" \"vite\"",
    "build": "vite build",
    "build:vercel": "prisma generate && vite build",
    "postinstall": "prisma generate",
    "push": "git push origin main",
    "lint": "eslint .",
    "preview": "vite preview",
    "firebase-deploy-rules": "firebase deploy --only firestore:rules",
    "firebase-deploy-indexes": "firebase deploy --only firestore:indexes",
    "firebase-deploy-firestore": "firebase deploy --only firestore",
    "firebase-deploy-storage": "firebase deploy --only storage",
    "firebase-deploy-all-rules": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.21.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prisma": "^6.11.1",
    "vite": "^8.0.12"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  }
}
