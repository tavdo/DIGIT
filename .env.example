# PostgreSQL (required on Vercel — use Vercel Postgres, Neon, or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/digit
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Optional: override default admin seed password (default: admin123)
# ADMIN_SEED_PASSWORD=admin123

# Vercel Blob — auto-set when you add Blob storage in Vercel project settings
# BLOB_READ_WRITE_TOKEN=

# Optional: one-time MongoDB data import (local dev only)
# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/digit
